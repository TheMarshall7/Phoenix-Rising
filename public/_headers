# HTML must never be cached long — desktop browsers kept stale index + wrong /assets/* responses.
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Hashed files: cache but allow revalidation (avoid locking in a bad HTML response as "immutable" JS).
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate
